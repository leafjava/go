SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=60s
LOG_LEVEL=info

# LLM（默认走 mock，把 LLM_MOCK_MODE 改 false 就能切真接口）
LLM_MOCK_MODE=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_MOCK_STREAM_CHUNK=30ms
LLM_REQUEST_TIMEOUT=30s